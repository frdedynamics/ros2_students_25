<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="two_dof_robot">

  <!-- ==================== Global Material Definitions ==================== -->
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  
  <material name="orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>

  <material name="teal">
    <color rgba="0.0 0.7 0.7 1.0"/>
  </material>

  <material name="bright_green">
    <color rgba="0.0 0.8 0.3 1.0"/>
  </material>

  <!-- ==================== Links ==================== -->

  <!-- Base Link (Fixed: Added inertial block so Gazebo keeps it) -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Link 1 -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.10"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.10"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.000529" ixy="0" ixz="0" iyy="0.000529" iyz="0" izz="0.000225"/>
    </inertial>
  </link>

  <!-- Link 2 -->
  <link name="link2">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.10"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.5 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.10"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.000171" ixy="0" ixz="0" iyy="0.000171" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- Fixed Left Finger -->
  <link name="left_finger_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.008 0.04"/>
      </geometry>
      <material name="teal">
        <color rgba="0.0 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.008 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.00000277" ixy="0" ixz="0" iyy="0.00000277" iyz="0" izz="0.00000021"/>
    </inertial>
  </link>

  <!-- Moving Right Finger -->
  <link name="right_finger_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.008 0.04"/>
      </geometry>
      <material name="bright_green">
        <color rgba="0.0 0.8 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.008 0.008 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.00000277" ixy="0" ixz="0" iyy="0.00000277" iyz="0" izz="0.00000021"/>
    </inertial>
  </link>

  <!-- ==================== Joints ==================== -->

  <!-- Joint 1: Revolute around Z-axis -->
  <joint name="joint1" type="revolute">
    <axis xyz="0 0 1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="link1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
  </joint>

  <!-- Joint 2: Revolute around X-axis -->
  <joint name="joint2" type="revolute">
    <axis xyz="1 0 0"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <parent link="link1"/>
    <child link="link2"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <!-- Left Finger Joint (Fixed) -->
  <joint name="left_finger_joint" type="fixed">
    <origin xyz="0 -0.015 0.10" rpy="0 0 0"/>
    <parent link="link2"/>
    <child link="left_finger_link"/>
  </joint>

  <!-- Right Finger Joint (Prismatic along Y-axis) -->
  <joint name="right_finger_joint" type="prismatic">
    <axis xyz="0 1 0"/>
    <origin xyz="0 0.015 0.10" rpy="0 0 0"/>
    <parent link="link2"/>
    <child link="right_finger_link"/>
    <limit lower="0.0" upper="0.03" effort="5" velocity="0.5"/>
  </joint>

  <!-- ==================== Gazebo Visual Tags ==================== -->

  <gazebo reference="link1">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="link2">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="left_finger_link">
    <material>Gazebo/Teal</material>
  </gazebo>

  <gazebo reference="right_finger_link">
    <material>Gazebo/Green</material>
  </gazebo>

  <!-- Gazebo Sim Joint State Publisher Plugin -->
  <gazebo>
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>/world/empty/model/two_dof_robot/joint_state</topic>
    </plugin>
  </gazebo>

  <!-- ROS 2 Control Hardware Interface -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo ROS 2 Control Plugin -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find my_robotarm_pkg)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>